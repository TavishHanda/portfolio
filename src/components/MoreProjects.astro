---
import { getCollection } from 'astro:content';

// Projects with `featured: false` show here as one-line rows.
const projects = (await getCollection('projects', (p) => !p.data.featured))
  .sort((a, b) => a.data.order - b.data.order);
---
<section class="more">
  <h3 class="mono">More projects</h3>
  <ul>
    {projects.map((p) => (
      <li>
        <div class="name">{p.data.title}</div>
        <p>{p.data.summary}</p>
        <div class="tags">{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
        {p.data.links.length > 0 && (
          <div class="links">{p.data.links.map((l) => <a href={l.href}>{l.label} ↗</a>)}</div>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .more { padding-bottom: 100px; }
  h3 { margin: 0 0 8px; font-weight: 400; }
  ul { list-style: none; margin: 0; padding: 0; }
  li {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) auto;
    align-items: baseline;
    gap: 8px 32px;
    padding-block: 18px;
    border-top: 1px solid var(--line);
  }
  li:last-child { border-bottom: 1px solid var(--line); }
  .name {
    font-family: var(--f-display);
    font-weight: 750;
    font-size: 20px;
    line-height: 1.2;
  }
  p { margin: 0; color: var(--muted); }
  .tags { justify-content: flex-end; }
  .links { grid-column: 2; display: flex; gap: 18px; font-size: 14px; font-weight: 500; }
  .links a { text-decoration: none; }
  .links a:hover { color: var(--accent); }

  @media (max-width: 820px) {
    li { grid-template-columns: minmax(0, 1fr); }
    .tags { justify-content: flex-start; }
    .links { grid-column: 1; }
  }
</style>
