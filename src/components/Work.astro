---
import { getCollection, render } from 'astro:content';
import ProjectArt from './ProjectArt.astro';

const projects = (await getCollection('projects', (p) => p.data.featured))
  .sort((a, b) => a.data.order - b.data.order);
const first = projects[0].data;
---
<section id="work">
  <div class="sec-head"><h2>Selected work</h2></div>
  <div class="work">
    <!-- Sticks in place while the cards scroll. The script below swaps its text. -->
    <div class="pin">
      <div class="count"><span id="pin-num">1</span> / {projects.length}</div>
      <div class="big" id="pin-title">{first.shortTitle}</div>
      <div class="tags" id="pin-tags">{first.tags.map((t) => <span class="tag">{t}</span>)}</div>
      <div class="bar"><i id="pin-bar"></i></div>
    </div>

    <div class="cards">
      {projects.map(async (p) => {
        const { Content } = await render(p);
        return (
          <article class="card" data-title={p.data.shortTitle} data-tags={p.data.tags.join(',')}>
            <ProjectArt id={p.id} />
            <h3>{p.data.title}</h3>
            <div class="mono meta">{p.data.meta}</div>
            <div class="body"><Content /></div>
            <div class="tags">{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
            {p.data.links.length > 0 && (
              <div class="links">
                {p.data.links.map((l) => <a href={l.href}>{l.label}</a>)}
              </div>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .work {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(24px, 5vw, 72px);
    padding-bottom: 80px;
  }
  .pin { position: sticky; top: 90px; align-self: start; min-width: 0; }
  .count { font-family: var(--f-mono); font-size: 13px; color: var(--muted); }
  .big {
    font-family: var(--f-display);
    font-variation-settings: "wdth" 75;
    font-weight: 900;
    font-size: clamp(56px, 9vw, 128px);
    line-height: .9;
    letter-spacing: -.03em;
    margin: 10px 0 18px;
    text-wrap: balance;
  }
  .bar { height: 3px; background: var(--line); margin-top: 28px; border-radius: 2px; overflow: hidden; }
  .bar i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .3s; }

  .cards { display: flex; flex-direction: column; gap: clamp(40px, 12vh, 120px); min-width: 0; }
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: clamp(20px, 3vw, 34px);
    transition: transform .5s cubic-bezier(.2, .7, .2, 1), border-color .3s;
  }
  .card.on { border-color: var(--accent); transform: translateY(-4px); }
  h3 {
    font-family: var(--f-display);
    font-weight: 750;
    font-size: 26px;
    letter-spacing: -.01em;
    line-height: 1.15;
    margin: 0 0 6px;
  }
  .meta { margin-bottom: 12px; }
  .body :global(p) { margin: 0; color: var(--muted); max-width: 60ch; }
  .card .tags { margin-top: 16px; }
  .links { display: flex; gap: 18px; margin-top: 16px; font-size: 14px; font-weight: 500; }
  .links a { text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 4px; }
  .links a:hover { color: var(--accent); }

  @media (max-width: 820px) {
    .work { grid-template-columns: minmax(0, 1fr); }
    .pin { display: none; }
  }
</style>

<script>
  // Watch which card is in the middle of the screen and copy its
  // title and tags into the pinned column on the left.
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  const pinTitle = document.getElementById('pin-title')!;
  const pinNum = document.getElementById('pin-num')!;
  const pinTags = document.getElementById('pin-tags')!;
  const pinBar = document.getElementById('pin-bar')!;

  function setActive(i: number) {
    const card = cards[i];
    cards.forEach((c, j) => c.classList.toggle('on', j === i));
    pinTitle.textContent = card.dataset.title ?? '';
    pinNum.textContent = String(i + 1);
    pinTags.replaceChildren(
      ...(card.dataset.tags ?? '').split(',').map((t) => {
        const span = document.createElement('span');
        span.className = 'tag';
        span.textContent = t;
        return span;
      }),
    );
    pinBar.style.width = `${((i + 1) / cards.length) * 100}%`;
  }

  setActive(0);
  // The -45% margins shrink the "viewport" to a thin band across the middle,
  // so a card counts as active only when it crosses that band.
  const observer = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && setActive(cards.indexOf(e.target as HTMLElement))),
    { rootMargin: '-45% 0px -45% 0px' },
  );
  cards.forEach((c) => observer.observe(c));
</script>
