---
// The slow wavy lines behind the hero. Drawn on a <canvas> every frame,
// and faded out as you scroll so they don't sit behind the content.
---
<canvas id="bg" aria-hidden="true"></canvas>

<style>
  #bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.getElementById('bg') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let w = 0;
  let h = 0;

  // The mouse pushes the lines aside. `target` is where the mouse is; `mouse` eases
  // toward it each frame so the lines glide instead of snapping. `strength` fades
  // the effect in when the mouse moves and out when it leaves the window.
  const target = { x: -9999, y: -9999, on: false };
  const mouse = { x: -9999, y: -9999, strength: 0 };
  addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    target.x = e.clientX;
    target.y = e.clientY;
    target.on = true;
  });
  document.addEventListener('pointerleave', () => (target.on = false));

  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    w = canvas.clientWidth;
    h = canvas.clientHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function draw(time: number) {
    const color = getComputedStyle(document.documentElement).getPropertyValue('--line').trim();
    const fade = Math.max(0, 1 - scrollY / (h * 1.2));
    if (mouse.strength < 0.01 && target.on) {
      mouse.x = target.x;
      mouse.y = target.y;
    }
    mouse.x += (target.x - mouse.x) * 0.12;
    mouse.y += (target.y - mouse.y) * 0.12;
    mouse.strength += ((target.on ? 1 : 0) - mouse.strength) * 0.06;
    ctx.clearRect(0, 0, w, h);

    if (fade > 0) {
      ctx.globalAlpha = fade;
      ctx.strokeStyle = color;
      ctx.lineWidth = 1.2;
      const lines = 22;
      const t = time * 0.00012;
      for (let i = 0; i < lines; i++) {
        const y0 = h * 0.15 + i * ((h * 0.8) / lines);
        ctx.beginPath();
        for (let x = 0; x <= w; x += 12) {
          // Three sine waves added together look more organic than one.
          let y =
            y0 +
            Math.sin(x * 0.004 + t * 3 + i * 0.35) * 18 +
            Math.sin(x * 0.011 - t * 2 + i * 0.6) * 8 +
            Math.sin(t + i * 0.2) * 6;
          // Push the line away from the mouse, strongest right under it and fading out by ~150px.
          const dx = x - mouse.x;
          const dy = y - mouse.y;
          const push = mouse.strength * 38 * Math.exp(-(dx * dx + dy * dy) / (2 * 90 * 90));
          // tanh eases the direction from "up" to "down" across the cursor instead of flipping, so no line snaps.
          y += push * Math.tanh(dy / 28);
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
      }
    }

    if (!reduceMotion) requestAnimationFrame(draw);
  }

  resize();
  addEventListener('resize', resize);
  requestAnimationFrame(draw);
</script>
