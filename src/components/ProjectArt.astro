---
// The illustration at the top of each featured project card.
// Scenes are drawn at build time from src/lib/scenes.ts, so the page
// ships plain SVG with no images and no JavaScript.
import { scenes } from '../lib/scenes';

interface Props {
  id: string;
}
const { id } = Astro.props;
const draw = scenes[id];
---
{draw && (
  <div class="art" aria-hidden="true">
    <svg viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" set:html={draw()} />
  </div>
)}

<style>
  .art {
    aspect-ratio: 16 / 9;
    max-width: 100%;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 22px;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    transition: transform .6s cubic-bezier(.2, .7, .2, 1);
  }
  /* The active card's scene eases in a touch closer. */
  :global(.card.on) svg { transform: scale(1.04); }

  @media (prefers-reduced-motion: reduce) {
    svg { transition: none; }
    :global(.card.on) svg { transform: none; }
  }
</style>
